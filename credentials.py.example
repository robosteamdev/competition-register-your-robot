# Copy to credentials.py on the Pico. Never share that file.
# Wi-Fi must be 2.4 GHz, with access to the competition broker.
# Your organiser chooses a router, phone hotspot or venue Wi-Fi.
# Enter the Wi-Fi settings for your location:
WIFI_SSID = "your-wifi-name"
WIFI_PASSWORD = "your-wifi-password"

# Ask the organiser for all four MQTT settings.
# Plain TCP only. 1883 is an example, not the venue's port.
# A public broker may use another port. Copy it exactly.
MQTT_BROKER = "your-broker-address"
MQTT_PORT = 1883
MQTT_USER = "your-mqtt-username"
MQTT_PASSWORD = "your-mqtt-password"
